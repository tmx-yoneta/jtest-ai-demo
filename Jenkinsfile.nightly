pipeline {
  agent any
  triggers {
    cron('H 2 * * *')
  }
  environment {
    JTEST_HOME                 = 'C:/Parasoft/jtest'
    ANALYZED_PROJECT_PATH      = "${WORKSPACE}"
    JTEST_STATIC_CONFIGURATION = 'builtin://Recommended Rules'
    JTEST_COMMIT_FIXES         = 'true'
    MAVEN_OPTS                 = '-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8'
  }
  stages {
    stage('全体スキャン') {
      steps {
        powershell '.\\mvnw.cmd -B clean test-compile jtest:jtest "-Djtest.report=build/jtest"'
        recordIssues tools: [parasoftFindings(pattern: 'build/jtest/report.xml')], id: 'jtest-findings'
      }
    }
    stage('AI自動修正（ブランチ作成のみ、PRは作らない）') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'github-jtest-ai-pat', usernameVariable: 'PAT_USER', passwordVariable: 'PAT_TOKEN')]) {
          powershell '''
            git checkout -B "nightly-fix/$env:BUILD_NUMBER"
            $env:JTEST_STATIC_BASE_REPORT = "$env:WORKSPACE\\build\\jtest\\report.xml"
            $prompt = "Use jtest-static-analysis to fix as many violations as possible, including low-severity ones. Do not run build or Jtest analysis (already provided). Fix at most 10 violations in this run. Commit each fix separately."
            & .\\scripts\\invoke-copilot.ps1 -Prompt $prompt
            & .\\scripts\\git-push-with-pat.ps1 -Branch "nightly-fix/$env:BUILD_NUMBER"
          '''
        }
      }
    }
  }
  post {
    always {
      echo "夜間バッチによるJtestスキャンが完了しました: ${env.BUILD_NUMBER} (${env.BUILD_URL})"
    }
  }
}
