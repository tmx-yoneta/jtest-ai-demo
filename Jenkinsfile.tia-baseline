pipeline {
  agent any
  triggers {
    cron('H 3 * * 0')
  }
  environment {
    JTEST_HOME = 'C:/Parasoft/jtest'
    MAVEN_OPTS = '-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8'
  }
  stages {
    stage('TIAベースライン生成') {
      steps {
        powershell '.\\mvnw.cmd clean test-compile jtest:agent test jtest:jtest "-Djtest.config=builtin://Unit Tests" "-Djtest.report=tia"'
        archiveArtifacts artifacts: 'tia/report.xml,tia/coverage.xml', fingerprint: true
        recordIssues tools: [parasoftFindings(pattern: 'tia/report.xml')], id: 'jtest-findings'
        recordParasoftCoverage pattern: 'tia/coverage.xml'
      }
    }
  }
}
